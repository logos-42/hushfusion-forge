__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.DS_Store

# Go build output (the CLI is run with `go run ./cmd/forge`, so no binary is
# tracked; keep the repo free of platform-specific artifacts)
/forge
/bin/
*.test

# generated run artifacts: the registry/results/report are evidence and stay,
# scratch and throwaway comparison files do not
runs/scratch/
runs/**/*.tmp

# forge os 双向打通的每次交互证据(带时间戳 JSON, 只作核对用): 决策落盘走
# os/DECISIONS.md / os/EXPERIMENTS.md 结构化文档, 不进 git
os/evidence/

# raw 原件(与仓库平级的本地 raw 根,外加编辑器状态): 只进 manifest,不进 git
.obsidian/
raw/
raw_local/
raw_vault/

# Bolloon kernel bridge 依赖 (npm install 产物, 不入库)
bridge/node_modules/

