__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.DS_Store

# Go build output (the CLI is run with `go run ./cmd/forge`, so no binary is
# tracked; keep the repo free of platform-specific artifacts)
/forge
/bin/
*.test

# generated run artifacts: the registry/results/report are evidence and stay,
# scratch and throwaway comparison files do not
runs/scratch/
runs/**/*.tmp

# forge os 双向打通的每次交互证据(带时间戳 JSON, 只作核对用): 决策落盘走
# os/DECISIONS.md / os/EXPERIMENTS.md 结构化文档, 不进 git
os/evidence/

# TUI 会话落盘(os/sessions/*.md + *.json): 运行时产物, 可由 --resume 现场用,
# 不是决策证据(证据在 os/ 与 docs/wiki/), 不进 git
os/sessions/

# workspace 模型配置（含 API key，0600）：只在本机使用，绝不入库
os/forge.config.json
/forge.config.json

# raw 原件(与仓库平级的本地 raw 根,外加编辑器状态): 只进 manifest,不进 git
.obsidian/
raw/
raw_local/
raw_vault/

# Bolloon kernel bridge 依赖 (npm install 产物, 不入库)
bridge/node_modules/
internal/dchat/node/node_modules/
dist/


# Crush 编辑器状态（不入库；名册门 IsTracked 亦跳过 .crush/）
.crush/
.forge/
.npm/
Library/
.cache/
.kilo/
.claude/

# 智能体运行时验证目录（商议/联调用，非仓库证据）
runs/orbitdb_verify/

# dchat 节点的 IPFS 运行时仓库（按 PID 命名，进程产物，非仓库证据）
forge-orbitdb-*/
