{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hushfusion.dev/schemas/0.1/device-state.schema.json",
  "title": "DeviceState",
  "description": "设备状态快照：模式 + 序号 + 时间戳 + 传感器读数。",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "device_id", "kind", "mode", "sequence", "timestamp"],
  "properties": {
    "contract_version": {"type": "string", "const": "0.1"},
    "device_id": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "enum": ["simulated", "hardware"]},
    "mode": {"type": "string", "enum": ["init", "standby", "running", "fault", "safe_stop", "shutdown"]},
    "sequence": {"type": "integer", "minimum": 0},
    "timestamp": {"type": "string", "minLength": 1},
    "measurements": {"type": "object", "additionalProperties": {"type": "number"}},
    "actuators": {"type": "object", "additionalProperties": {"type": "number"}},
    "fault_reason": {"type": "string"}
  }
}
