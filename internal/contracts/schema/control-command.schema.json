{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hushfusion.dev/schemas/0.1/control-command.schema.json",
  "title": "ControlCommand",
  "description": "发给设备的控制命令：意图，不是许可。未经安全内核判决不得进入设备。",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "command_id", "device_id", "kind", "sequence", "issued_at"],
  "properties": {
    "contract_version": {"type": "string", "const": "0.1"},
    "command_id": {"type": "string", "minLength": 1},
    "device_id": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "enum": ["set_actuator", "safe_stop", "shutdown"]},
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actuator", "value"],
        "properties": {
          "actuator": {"type": "string", "minLength": 1},
          "value": {"type": "number"}
        }
      }
    },
    "sequence": {"type": "integer", "minimum": 0},
    "issued_at": {"type": "string", "minLength": 1},
    "reason": {"type": "string"}
  }
}
