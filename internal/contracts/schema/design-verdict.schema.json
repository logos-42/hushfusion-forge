{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hushfusion.dev/schemas/0.1/design-verdict.schema.json",
  "title": "DesignVerdict",
  "description": "一次设计判决的完整结果。unknown 永远不等于 pass。",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "design_id", "overall", "gates"],
  "properties": {
    "contract_version": {"type": "string", "const": "0.1"},
    "design_id": {"type": "string", "minLength": 1},
    "overall": {"type": "string", "enum": ["accepted", "rejected", "inconclusive"]},
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/gate"}
    },
    "decisive_keys": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "status", "value", "threshold"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["pass", "fail", "unknown"]},
        "value": {"type": "number"},
        "threshold": {"type": "number"},
        "unit": {"type": "string"},
        "detail": {"type": "string"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "uri"],
      "properties": {
        "kind": {"type": "string", "enum": ["trace", "record", "gate", "report", "external"]},
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"type": "string"},
        "forge_version": {"type": "string"},
        "produced_at": {"type": "string"}
      }
    }
  }
}
